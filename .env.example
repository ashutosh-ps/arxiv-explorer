# Copy to .env.local for local dev, or set these in your Vercel project settings.
# Everything has a safe default for local dev, so the app runs with NONE of these set
# (it uses an in-memory store/db). Production needs at least DATABASE_URL and JWT_SECRET.

# --- Required in production (auth + per-user bookmarks) ---
# Neon Postgres connection string. Without it the app uses an in-memory store, which on
# serverless is per-instance and won't persist. Run `npm run db:migrate` after setting it.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Secret used to sign/verify auth JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional: shared cache + rate limiting (Upstash Redis) ---
# Without these, caching and rate limiting use an in-memory store (per serverless instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: gateway tuning (defaults shown) ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=5
ARXIV_CACHE_TTL_SECONDS=3600
ARXIV_RETRY_ATTEMPTS=3
ARXIV_TIMEOUT_MS=8000
ARXIV_BREAKER_THRESHOLD=5
ARXIV_BREAKER_COOLDOWN_MS=30000
